{
  "id": "sharkapp",
  "name": "Batteries (SharkApp)",
  "version": "1.0.0",
  "api": 0,
  "author": "KingsRequin",
  "description": "Batteries du téléphone et de la montre, alerte batterie faible et appel en cours dans l'îlot (fichiers de l'agent SharkApp).",
  "icon": "batteryFull",
  "widget": { "squeeze": 6 },
  "permissions": {
    "files": ["%LOCALAPPDATA%/KingsHub/batteries.json", "%LOCALAPPDATA%/KingsHub/phone.json"]
  },
  "settings": [
    { "key": "seuil", "type": "number", "label": "Alerte batterie faible (%, 0 : jamais)", "default": 15, "min": 0, "max": 100 },
    { "key": "appels", "type": "bool", "label": "Appel du téléphone dans l'îlot", "default": true }
  ]
}
