// Batteries du téléphone et de la montre (envoyées par l'agent SharkApp). Une mesure ancienne
// est atténuée ; sous le seuil réglé : couleur d'alerte ; rien tant qu'aucune n'est connue.
import { Island, Icon, Theme } from "@horizon";

export struct Batterie {
    icone: string,
    pourcent: string,
    charge: bool,
    faible: bool,
    ancienne: bool,
}

export component Widget inherits Window {
    in property <[Batterie]> batteries;
    background: transparent;

    if root.batteries.length > 0: VerticalLayout {
        alignment: center;
        Island {
            gap: 10px;
            for b in root.batteries: HorizontalLayout {
                spacing: 4px;
                opacity: b.ancienne ? 0.6 : 1;
                property <color> teinte: b.faible ? Theme.bad : b.charge ? Theme.ok : Theme.text;
                Icon {
                    name: b.icone;
                    size: 14px;
                    color: teinte;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: b.pourcent;
                    color: teinte;
                    font-family: Theme.font-mono;
                    font-weight: 500;
                    font-size: Theme.fs-meta;
                    vertical-alignment: center;
                }
                if b.charge: Icon {
                    name: "lightning";
                    size: 10px;
                    color: teinte;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}
