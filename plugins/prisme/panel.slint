// Panneau : scènes (la scène forcée cochée), éteindre ou rallumer, luminosité, ouvrir Prisme.
import { PanelBase, ListRow, Icon, Theme } from "@horizon";

export struct Scene {
    cle: string,
    nom: string,
    choisie: bool,
}

export component Panel inherits Window {
    in property <bool> connecte;
    in property <bool> eteint;
    in property <[Scene]> scenes;
    in property <float> luminosite: 1;
    // Scène forcée (vide : règles automatiques).
    callback choisir(string);
    callback basculer();
    callback lumiere(float);
    callback ouvrir();
    background: transparent;

    PanelBase {
        title: "Éclairage";
        if !root.connecte: Text {
            text: "Prisme n’est pas lancé.";
            color: Theme.text-dim;
            font-size: Theme.fs-body;
        }
        if root.connecte: ListRow {
            icon: root.eteint ? "lightbulbFill" : "power";
            title: root.eteint ? "Rallumer" : "Éteindre";
            clicked => { root.basculer(); }
        }
        if root.connecte: ListRow {
            icon: "sparkle";
            title: "Automatique";
            subtitle: "Scène choisie par les règles de Prisme";
            clicked => { root.choisir(""); }
        }
        for s in root.scenes: ListRow {
            icon: s.choisie ? "check" : "lightbulb";
            title: s.nom;
            clicked => { root.choisir(s.cle); }
        }
        if root.connecte: HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            height: 32px;
            Icon { name: "sun"; y: (parent.height - self.height) / 2; }
            Rectangle {
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.luminosite, 0, 1);
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.accent;
                }
                TouchArea {
                    height: 24px;
                    mouse-cursor: pointer;
                    clicked => { root.lumiere(clamp(self.mouse-x / self.width, 0, 1)); }
                }
            }
            Text {
                text: round(root.luminosite * 100) + " %";
                color: Theme.text-dim;
                font-size: Theme.fs-meta;
                vertical-alignment: center;
                width: 40px;
                horizontal-alignment: right;
            }
        }
        if root.connecte: ListRow {
            icon: "arrowSquareOut";
            title: "Ouvrir Prisme";
            clicked => { root.ouvrir(); }
        }
    }
}
