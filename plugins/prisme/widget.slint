// Éclairage (Prisme) : scène en cours ; survol : scènes, extinction, luminosité.
import { Island, Icon, Theme } from "@horizon";

export component Widget inherits Window {
    in property <bool> connecte;
    in property <bool> eteint;
    in property <string> scene;
    background: transparent;

    VerticalLayout {
        alignment: center;
        Island {
            opacity: root.connecte ? 1 : 0.4;
            Icon {
                name: root.connecte && !root.eteint ? "lightbulbFill" : "lightbulb";
                size: 14px;
                color: root.connecte && !root.eteint ? Theme.accent : Theme.text-dim;
                y: (parent.height - self.height) / 2;
            }
            if root.connecte && !root.eteint: Text {
                text: root.scene;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}
